{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  schedule: [
    '* 0-6 * * 1',
  ],
  ignorePaths: [
    '**/test_resources/**',
  ],
  dependencyDashboard: true,
  branchConcurrentLimit: 0,
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  rebaseWhen: 'behind-base-branch',
  prBodyTemplate: '{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}',
  commitMessageTopic: '{{depName}}',
  customManagers: [
    {
      description: 'Library version (tracks gradle-enterprise Helm chart, resets patch to .0)',
      customType: 'regex',
      managerFilePatterns: [
        '/^gradle\\.properties$/',
      ],
      matchStrings: [
        '(?m)^version=(?<currentValue>\\d+\\.\\d+)(?:\\.\\d+)?',
      ],
      depNameTemplate: 'gradle-enterprise',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://helm.gradle.com',
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+)',
      autoReplaceStringTemplate: 'version={{newMajor}}.{{newMinor}}.0',
      versioningTemplate: 'semver-coerced',
    },
    {
      description: 'Develocity API spec version (tracks gradle-enterprise Helm chart, resets patch to .0)',
      customType: 'regex',
      managerFilePatterns: [
        '/^gradle\\.properties$/',
      ],
      matchStrings: [
        '(?m)^develocity\\.api\\.spec\\.version=(?<currentValue>\\d+\\.\\d+)(?:\\.\\d+)?',
      ],
      depNameTemplate: 'gradle-enterprise',
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://helm.gradle.com',
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+)',
      autoReplaceStringTemplate: 'develocity.api.spec.version={{newMajor}}.{{newMinor}}.0',
      versioningTemplate: 'semver-coerced',
    },
    {
      description: 'okhttp version forced in the consumer okhttp5-upgrade examplesTest scenario',
      customType: 'regex',
      managerFilePatterns: [
        '/^library\\/src\\/examplesTest\\/resources\\/force-consumer-okhttp5\\.init\\.gradle\\.kts$/',
      ],
      matchStrings: [
        'force\\("com\\.squareup\\.okhttp3:okhttp:(?<currentValue>[\\d.]+)"\\)',
      ],
      depNameTemplate: 'com.squareup.okhttp3:okhttp',
      datasourceTemplate: 'maven',
      versioningTemplate: 'semver-coerced',
    },
  ],
  packageRules: [
    {
      matchDepNames: [
        'com.gradle.develocity',
        'com.gradle:develocity-gradle-plugin',
      ],
      prBodyNotes: [
        'https://docs.gradle.com/develocity/gradle-plugin/current#release_history',
      ],
      groupName: 'Develocity Gradle plugin',
      groupSlug: 'develocity-gradle-plugin',
      commitMessageTopic: 'Develocity Gradle plugin',
    },
    {
      matchDepNames: [
        'org.jetbrains.kotlinx:kotlin-jupyter-test-kit',
        'org.jetbrains.kotlinx:kotlin-jupyter-api',
        'org.jetbrains.kotlinx:kotlin-jupyter-api-gradle-plugin',
        'org.jetbrains.kotlin.jupyter.api',
      ],
      groupName: 'Kotlin/Jupyter',
      groupSlug: 'kotlin-jupyter',
      commitMessageTopic: 'Kotlin/Jupyter',
    },
    {
      matchFileNames: [
        '.github/scripts/**',
      ],
      groupName: '.github/scripts dependencies',
      commitMessageTopic: '.github/scripts dependencies',
      commitMessageExtra: '',
    },
    {
      matchFileNames: [
        'examples/**',
      ],
      groupName: 'examples dependencies',
      commitMessageTopic: 'examples dependencies',
      commitMessageExtra: '',
    },
    {
      matchDepNames: [
        'gradle-enterprise',
      ],
      branchTopic: 'develocity-api-spec',
      prBodyNotes: [
        '[Develocity release history](https://docs.gradle.com/develocity/current/reference/release-history/#{{newMajor}}-{{newMinor}})',
      ],
      commitMessageAction: 'Bump versions for',
      commitMessageTopic: 'Develocity API',
      commitMessageExtra: '{{newValue}}',
    },
    {
      matchFileNames: [
        'gradle/libs.versions.toml',
      ],
      matchDepNames: [
        'com.squareup.okhttp3:okhttp',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
  ],
}
